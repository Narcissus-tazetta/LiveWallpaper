# SwiftFormat configuration for LiveWallpaper
# run with `swiftformat . --config .swiftformat`

--indent 4
--maxwidth 100
--allman false
--wraparguments beforefirst
--wrapelements beforefirst
--commas inline
--header ignore
--disable redundantReturn
--disable trailingClosures
--swiftversion 5.10
--exclude .build,.claude,dist,site,store-worker,homebrew-tap,we-cli,Sources/QuickJS/vendor
